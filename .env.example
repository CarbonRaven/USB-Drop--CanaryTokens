# USB Drop Campaign Management System - Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# VPS Configuration
# =============================================================================
VPS_IP=your.server.ip.address

# =============================================================================
# Domain Configuration
# =============================================================================
CANARY_DOMAIN=subproject55.com
APP_DOMAIN=subproject55.com

# =============================================================================
# Database
# =============================================================================
DB_PASSWORD=generate-a-strong-password-here
DATABASE_URL=postgresql://usbdrop:${DB_PASSWORD}@postgres:5432/usbdrop

# =============================================================================
# CanaryTokens Configuration
# =============================================================================
# Generate with: openssl rand -hex 32
FACTORY_AUTH=your-factory-auth-token

# Webhook URL for CanaryTokens to send alerts back to your API
# This is REQUIRED for token creation to work
WEBHOOK_URL=https://api.subproject55.com/api/webhooks/canary

# =============================================================================
# Redis Configuration
# =============================================================================
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=your-redis-password

# =============================================================================
# IPinfo (for IP geolocation)
# =============================================================================
# Get from: https://ipinfo.io/account/token
IPINFO_TOKEN=your-ipinfo-token

# Google API Key (required for CanaryTokens)
# Used for: Google Docs tokens, Google Maps/GeoIP features
# Get from: https://console.cloud.google.com/apis/credentials
# Enable APIs: Maps JavaScript API, Places API, Docs API
GOOGLE_API_KEY=your-google-api-key

# =============================================================================
# Email Provider (choose one)
# =============================================================================
# Mailgun
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.subproject55.com
MAILGUN_BASE_URL=https://api.mailgun.net

# OR SendGrid
# SENDGRID_API_KEY=your-sendgrid-api-key

# =============================================================================
# OpenAI (for content generation)
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key

# =============================================================================
# Cloudflare (for wildcard SSL certificates)
# =============================================================================
# Required for *.subproject55.com wildcard certificate (CanaryTokens callbacks)
# Get from: https://dash.cloudflare.com/profile/api-tokens
# Create token with Zone:DNS:Edit permissions for your domain
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# =============================================================================
# Slack Notifications
# =============================================================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# =============================================================================
# JWT Authentication
# =============================================================================
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# Initial Admin User (created on first run)
# =============================================================================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# =============================================================================
# CanaryTokens UI Basic Auth (tokens.subproject55.com)
# =============================================================================
# Generate hash with: docker exec caddy caddy hash-password
# Default password is "changeme" - CHANGE THIS!
TOKENS_BASIC_AUTH_USER=admin
TOKENS_BASIC_AUTH_HASH=$2a$14$UxG/WzJFR7AKvLHn9hVBqevc7oLJdPBxPtrFsEqzWMxjQGdJzHAXy

# =============================================================================
# Shlink URL Shortener
# =============================================================================
# Domain for short links
SHLINK_DOMAIN=links.subproject55.com
# Generate with: openssl rand -hex 32
SHLINK_API_KEY=your-shlink-api-key
# Generate with: openssl rand -hex 16
SHLINK_DB_PASSWORD=your-shlink-db-password
# Optional: MaxMind GeoLite2 license key for geographic stats
# Get from: https://www.maxmind.com/en/geolite2/signup
GEOLITE_LICENSE_KEY=

# =============================================================================
# WireGuard (for WireGuard tokens)
# =============================================================================
# Generate with: dd bs=32 count=1 if=/dev/urandom 2>/dev/null | base64
WG_PRIVATE_KEY_SEED=your-wireguard-key-seed
